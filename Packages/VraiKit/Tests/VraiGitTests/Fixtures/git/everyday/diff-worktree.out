diff --git a/Sources/VraiGit/Graph/LaneLayout.swift b/Sources/VraiGit/Graph/LaneLayout.swift
index d526bb3..a0ed363 100644
--- a/Sources/VraiGit/Graph/LaneLayout.swift
+++ b/Sources/VraiGit/Graph/LaneLayout.swift
@@ -65,6 +65,14 @@ struct LaneLayout {
         return path
     }
 
+    func halo(at lane: Int, in rect: CGRect, radius: CGFloat) -> Path {
+        let center = CGPoint(x: x(for: lane), y: rect.midY)
+        return Path(ellipseIn: CGRect(x: center.x - radius / 2, y: center.y - radius / 2, width: radius, height: radius))
+    }
+
+    /// Space before the first lane, so the halo never clips.
+    var inset: CGFloat { (haloSize - nodeSize) / 2 }
+
     func node(at lane: Int, in rect: CGRect, merge: Bool = false) -> Path {
         let size = merge ? nodeSize - 0.5 : nodeSize
         return Path(ellipseIn: CGRect(x: x(for: lane) - size / 2, y: rect.midY - size / 2, width: size, height: size))
